{
  "name": "dsh-remote-access-cidr",
  "version": "1.0.0",
  "type": "module",
  "description": "Expose this machine's DSH web GUI to a chosen CIDR range (e.g. Tailscale), with an optional numeric access code.",
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mzy123l/dsh-remote-access.git"
  },
  "homepage": "https://github.com/Mzy123l/dsh-remote-access#readme",
  "bugs": {
    "url": "https://github.com/Mzy123l/dsh-remote-access/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "remote-access",
    "cidr",
    "tailscale"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "meta": {
    "title": "远程访问入口（限网段）",
    "description": "把本机 DSH 网页界面开放给指定网段（默认 Tailscale 100.64.0.0/10）：只监听网段内的本机地址，网段外一律拒绝；可复制带票网址，也可设数字密码直接访问。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
