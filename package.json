{
  "name": "@local/dsh-remote-access",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Expose this machine's DSH web GUI to a chosen network range (e.g. Tailscale), token-gated.",
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "meta": {
    "title": "远程访问入口（限网段）",
    "description": "把本机 DSH 网页界面开放给指定网段（默认 Tailscale 100.64.0.0/10），只允许带令牌的访问；参数可在设置页里直接改。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
